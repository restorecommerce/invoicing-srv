{
  "name": "invoicing-srv",
  "version": "1.4.9",
  "main": "./dist/start.cjs",
  "description": "Generic Invoicing Service",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/invoicing-srv.git"
  },
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.2.2",
    "@restorecommerce/chassis-srv": "^1.9.2",
    "@restorecommerce/grpc-client": "^2.3.2",
    "@restorecommerce/kafka-client": "^1.4.2",
    "@restorecommerce/logger": "^1.4.2",
    "@restorecommerce/rc-grpc-clients": "5.2.2",
    "@restorecommerce/resource-base-interface": "^1.10.2",
    "@restorecommerce/service-config": "^1.2.2",
    "csv-parse": "^7.0.1",
    "redis": "^6.1.0",
    "sprintf-js": "^1.1.3"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@restorecommerce/dev": "^0.3.1",
    "@restorecommerce/protos": "^6.16.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/sprintf-js": "^1.1.4",
    "async-mutex": "^0.5.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node dist/start.cjs",
    "dev": "cross-env NODE_ENV=development nodemon --watch './src/**/*.ts' --exec node --loader ts-node/esm ./src/start.ts",
    "test": "npm run lint && vitest run",
    "lint": "eslint src --fix --ignore-pattern **/*.d.ts",
    "build:es": "node esbuild.mjs",
    "build:clean": "rimraf dist lib",
    "build": "npm-run-all build:clean build:es",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/invoicing-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/invoicing-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
